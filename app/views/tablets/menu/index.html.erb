<div class="row g-3">
  <% if current_user.manageable? %>
    <div class="col-6 col-sm-4 col-md-3 col-lg-2">
      <%= link_to new_tablets_plans_work_type_path, class: "btn btn-warning w-100 py-4 text-start" do %>
        <span class="d-block fs-5 fw-bold">作付予定</span>
        <span class="d-block small opacity-75">翌年度の品種を設定</span>
      <% end %>
    </div>
    <div class="col-6 col-sm-4 col-md-3 col-lg-2">
      <%= link_to new_tablets_plans_land_path, class: "btn btn-warning w-100 py-4 text-start" do %>
        <span class="d-block fs-5 fw-bold">作付計画</span>
        <span class="d-block small opacity-75">翌年度の圃場を設定</span>
      <% end %>
    </div>
  <% end %>
  <div class="col-6 col-sm-4 col-md-3 col-lg-2">
    <%= link_to tablets_maps_path, class: "btn btn-primary w-100 py-4 text-start" do %>
      <span class="d-block fs-5 fw-bold">面積集計</span>
      <span class="d-block small opacity-75">地図を表示</span>
    <% end %>
  </div>
  <div class="col-6 col-sm-4 col-md-3 col-lg-2">
    <%= link_to tablets_statistics_path, class: "btn btn-success w-100 py-4 text-start" do %>
      <span class="d-block fs-5 fw-bold">統計情報</span>
      <span class="d-block small opacity-75">グラフを表示</span>
    <% end %>
  </div>
</div>
<div class="row g-3 mt-1">
  <div class="col-6 col-sm-4 col-md-3 col-lg-2">
    <%= link_to tablets_lands_chemicals_path, class: "btn btn-success w-100 py-4 text-start" do %>
      <span class="d-block fs-5 fw-bold">農薬散布地図</span>
      <span class="d-block small opacity-75">田植え圃場を確認</span>
    <% end %>
  </div>
</div>
<div class="row g-3">

  <div class="col-6 col-sm-4 col-md-3 col-lg-2">
    <%= link_to new_tablets_session_path, class: "btn btn-danger w-100 py-4 text-start", data: { turbo_prefetch: false } do %>
      <span class="d-block fs-5 fw-bold">ログアウト</span>
      <span class="d-block small opacity-75">セッションを終了</span>
    <% end %>
  </div>
</div>
