<h1>対象年度変更</h1>
<%= form_with(model: @system, url: {controller: :menu, action: :update }, html: {method: :put}) do |f| %>
  <div class="row">
    <div class="col-md-2">
      <%= f.select(:term, @terms, {}, {class: "form-select"}) %>
    </div>
  </div>
  <div class="btn-toolbar">
    <div class="btn-group mr-2">
      <%= f.submit '設定', class: "btn btn-danger" %>
    </div>
    <div class="btn-group mr-2">
      <%= link_to "戻る", menu_index_path, {class: "btn btn-outline-dark"}%>
    </div>
  </div>
<% end %>

<% if @new_system %>
  <h2><%= @new_system.persisted? ? "次期年度設定" : "新規年度追加" %></h2>
  <%= error_print(@new_system) %>
  <%= form_with(model: @new_system, url: {controller: :menu, action: :update}, html: {method: :put}) do |f| %>
    <%= f.hidden_field :term, id: nil %>
    <div class="row">
      <div class="col-md-2 mb-3">
        <%= f.label :term_name, class: "col-form-label-lg form-label" %>
        <%= f.text_field :term_name, maxlength: 10, required: true, class: "form-control" %>
      </div>
      <div class="col-md-2 mb-3">
        <%= f.label :start_date, class: "col-form-label-lg form-label" %>
        <%= f.date_field :start_date, required: true, class: "form-control" %>
      </div>
      <div class="col-md-2 mb-3">
        <%= f.label :end_date, class: "col-form-label-lg form-label" %>
        <%= f.date_field :end_date, required: true, class: "form-control" %>
      </div>
    </div>
    <div class="btn-toolbar">
      <div class="btn-group mr-2">
        <%= f.submit(@new_system.persisted? ? "更新" : "追加", class: "btn btn-danger") %>
      </div>
    </div>
  <% end %>
<% end %>
