<% machine_results_by_machine = @work.machine_results.group_by(&:machine_id) %>
<div id="content_machines" class="<%= class_names("content", "no-print": @machines.empty?) %>">
  <table id="detail_machines">
    <thead>
    <tr>
      <th style="width:180px;">機械名</th>
      <th style="width:120px;">稼働／使用料</th>
      <th style="width:180px;">オペレーター</th>
      <th style="width:300px;">備考(ヒヤリ・ハット含む)</th>
    </tr>
    </thead>
    <tbody>
      <% [current_organization.machines_count, @machines.count].max.times do |i| %>
      <tr>
        <td class="machine"><%= @machines[i] ? @machines[i].usual_name : "" %></td>
        <td class="machine numeric"><% if @machines[i] %>
          <% entries = machine_results_by_machine.fetch(@machines[i].id, []) %>
          <% if entries.any? { |entry| entry.input_amount.present? } %>
            <%= number_with_delimiter(entries.sum { |entry| entry.input_amount || 0 }) %>円
          <% else %>
            <%= @machines[i].hours(@results.object) %>
          <% end %>
        <% end %></td>
        <td class="machine"><%= @machines[i] ? @machines[i].operators(@work) : "" %></td>
        <td class="machine"><%= @machines[i] ? @machines[i].remarks(@work)&.remarks : "" %></td>
      </tr>
      <% end %>
    </tbody>
  </table>
  <div id="cover_machines" class="cover" onclick="location.href='<%=raw new_work_machine_path(work_id: @work) %>'"></div>
</div>
