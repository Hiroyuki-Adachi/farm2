<h1>基盤強化準備金明細登録(<%= current_system.term_name %>)</h1>
<p><%= @fund.machine.type_name %> / <%= @fund.machine.alias_name %></p>
<p>按分月数: <%= @detail.months %>ヶ月 / 残額: <%= number_with_delimiter(@fund.current_remaining_amount) %>円</p>
<%= error_print(@detail) %>
<%= form_with model: @detail, data: {turbo: false} do |f| %>
  <%= hidden_field_tag :machine_reserve_fund_id, @fund.id %>
  <div class="mb-3">
    <%= f.label :amount, "原価額", class: "form-label" %>
    <%= f.number_field :amount, min: 0, max: @fund.current_remaining_amount, step: 1, required: true, class: "form-control" %>
  </div>
  <%= f.submit "登録", class: "btn btn-warning" %>
  <%= link_to "戻る", machine_reserve_fund_details_path, class: "btn btn-outline-dark" %>
<% end %>
