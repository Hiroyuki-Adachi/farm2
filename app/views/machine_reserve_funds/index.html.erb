<h1>基盤強化準備金データ一覧</h1>
<% if @machine_reserve_funds.count > 0 %>
<table class="table table-sm">
  <thead>
    <tr>
      <th>機種</th>
      <th>機械</th>
      <th>開始年月</th>
      <th>配分年数</th>
      <th class="text-end">総額</th>
      <th class="text-end">残額</th>
      <th>&nbsp;</th>
    </tr>
  </thead>
  <tbody>
    <% @machine_reserve_funds.each do |reserve_fund| %>
      <tr>
        <td><%= reserve_fund.machine.type_name %></td>
        <td><%= reserve_fund.machine.alias_name %></td>
        <td><%= reserve_fund.started_on.strftime('%Y-%m') %></td>
        <td><%= reserve_fund.years %></td>
        <td class="text-end"><%= number_with_delimiter(reserve_fund.total_amount) %></td>
        <td class="text-end"><%= number_with_delimiter(reserve_fund.remaining_amount) %></td>
        <td>
          <%= link_to '変更', edit_machine_reserve_fund_path(reserve_fund, return_to: request.fullpath), class: "btn btn-success btn-sm" %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
<% end %>
<div class="btn-toolbar">
  <div class="btn-group mr-2">
    <%= link_to '新規登録', new_machine_reserve_fund_path, class: "btn btn-success" %>
  </div>
  <div class="btn-group mr-2">
    <%= link_to '戻る', menu_index_path, class: "btn btn-outline-dark" %>
  </div>
</div>
