<%= error_print(@machine_reserve_fund) %>
<%= form_with(model: @machine_reserve_fund) do |f| %>
<%= hidden_field_tag :return_to, @return_to if @return_to.present? %>
<div class="row">
 <div class="col-md-3 mb-3">
    <%= label_tag :machine_type_id, "機種", class: "col-form-label-lg form-label" %>
    <%= select_tag :machine_type_id,
      options_from_collection_for_select(@machine_types, :id, :name, @selected_machine_type_id),
      {
        include_blank: true,
        class: "form-select",
        data: {
          controller: "dependent-select",
          dependent_select_url_value: machines_machine_reserve_funds_path,
          dependent_select_param_name_value: "machine_type_id",
          action: "change->dependent-select#fetch"
        }
      } %>
 </div>
 <div class="col-md-3 mb-3">
    <%= f.label :machine_id, "機械", class: "col-form-label-lg form-label" %>
    <%= f.collection_select(:machine_id, @machines, :id, :usual_name, {include_blank: true}, {class: "form-select", id: :machine_id, required: true}) %>
 </div>
 <div class="col-md-2 mb-3">
    <%= f.label :started_on, "開始年月", class: "col-form-label-lg form-label" %>
    <%= f.date_field :started_on, {required: true, class: "form-control"} %>
 </div>
 <div class="col-md-2 mb-3">
    <%= f.label :years, "配分年数", class: "col-form-label-lg form-label" %>
    <%= f.number_field :years, {min: 1, max: 99, required: true, class: "form-control"} %>
 </div>
 <div class="col-md-2 mb-3">
    <%= f.label :total_amount, "総額", class: "col-form-label-lg form-label" %>
    <%= f.number_field :total_amount, {min: 0, max: 999999999, required: true, class: "form-control"} %>
 </div>
</div>
<div class="btn-toolbar">
  <div class="btn-group mr-2">
    <%= f.submit '登録', class: "btn btn-warning" %>
  </div>
  <% if @machine_reserve_fund.persisted? && !@machine_reserve_fund.details? %>
  <div class="btn-group mr-2">
    <%= link_to '削除', machine_reserve_fund_path(@machine_reserve_fund, return_to: @return_to), {data: {turbo_confirm: "本当に削除してもよろしいですか?", turbo_method: :delete}, class: "btn btn-danger"} %>
  </div>
  <% end %>
  <div class="btn-group mr-2">
    <%= link_to '戻る', @return_to.presence || machine_reserve_funds_path, class: "btn btn-outline-dark" %>
  </div>
</div>
<% end %>
