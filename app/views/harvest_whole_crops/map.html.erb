<div class="row" data-controller="page-loader" data-page-loader-modules-value="pages/harvest-whole-crops-map">
  <div class="col-md-12">
    <h1>収穫地図(WCS)</h1>
  </div>
</div>
<div class="row mb-3">
  <div class="col-md-12">
    <div id="map" class="ratio ratio-16x9"></div>
  </div>
</div>
<div class="row mb-3">
  <div class="col-md-12">
    <h3 id="land_info">&nbsp;</h3>
  </div>
</div>
<%= hidden_field_tag :location, "[#{current_location}]" %>
<%= hidden_field_tag :organization_name, current_organization.name %>
<% @lands.each do |land| %>
  <%= land_region_hidden_field(land, color: "#ffffff") %>
<% end %>
<div class="btn-toolbar">
  <div class="btn-group mr-2">
    <%= link_to '戻る', harvest_whole_crops_path, {class: "btn btn-outline-dark"} %>
  </div>
</div>
