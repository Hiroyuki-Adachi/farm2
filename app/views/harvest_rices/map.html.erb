<div class="row" data-controller="page-loader" data-page-loader-modules-value="pages/harvest-whole-crops-map">
  <div class="col-md-12">
    <h1>収穫地図(水稲)</h1>
  </div>
</div>
<div class="row mb-3">
  <div class="col-md-12">
    <div id="map" data-yield-label="俵数" data-yield-key="bales" class="ratio ratio-16x9"></div>
  </div>
</div>
<%= render "harvest_rices/map_legend" %>
<div class="row mb-3">
  <div class="col-md-12">
    <h3 id="land_info">&nbsp;</h3>
  </div>
</div>
<%= hidden_field_tag :location, "[#{current_location}]" %>
<%= hidden_field_tag :organization_name, current_organization.name %>
<% @lands.each do |land| %>
  <% summary = @rice_land_summaries[land.id] %>
  <%= land_region_hidden_field(land, color: summary.color, extra_data: { bales: summary.bales }) %>
<% end %>
<div class="btn-toolbar">
  <div class="btn-group mr-2">
    <%= link_to '戻る', harvest_rices_path, {class: "btn btn-outline-dark"} %>
  </div>
</div>
